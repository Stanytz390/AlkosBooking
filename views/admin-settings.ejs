<%- include("partials/head", {title: "Settings — Admin"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a href="/admin">Dashboard</a><a href="/admin/bookings">Bookings</a><a href="/admin/units">Apartments</a><a href="/admin/gallery">Gallery</a><a href="/admin/reviews">Reviews</a><a class="active" href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">PROPERTY CONTROL</span><h1>Settings</h1></div></div><section class="admin-card"><form method="post" action="/admin/settings" class="admin-form"><div class="form-row"><label>Property name<input name="propertyName" value="<%= settings.propertyName %>"></label><label>Tagline<input name="tagline" value="<%= settings.tagline %>"></label></div><label>Description<textarea name="description" rows="5"><%= settings.description %></textarea></label><div class="form-row"><label>Location<input name="location" value="<%= settings.location %>"></label><label>Phone<input name="phone" value="<%= settings.phone %>"></label></div><div class="form-row"><label>WhatsApp number<input name="whatsapp" value="<%= settings.whatsapp %>"></label><label>Instagram URL<input name="instagram" value="<%= settings.instagram %>"></label></div><label>Google Maps URL<input name="mapUrl" value="<%= settings.mapUrl %>"></label><div class="form-row"><label>Check-in<input name="checkIn" value="<%= settings.checkIn %>"></label><label>Check-out<input name="checkOut" value="<%= settings.checkOut %>"></label><label>Max guests<input name="maxGuests" type="number" value="<%= settings.maxGuests %>"></label></div><button class="btn btn-dark">Save property settings</button></form></section><section class="admin-card"><h2>System notes</h2><p class="muted">The booking engine uses MongoDB for property, room, booking, review and gallery data. The session secret is generated automatically and stored in MongoDB, so you do not need to hard-code it in Heroku.</p><p class="muted">Guests do not need an account. Booking requests are created first, then the guest can send a prepared WhatsApp message for confirmation.</p></section></main></div>
