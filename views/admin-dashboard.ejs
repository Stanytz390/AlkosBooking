<%- include("partials/head", {title: "Admin Dashboard"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a class="active" href="/admin">Dashboard</a><a href="/admin/bookings">Bookings</a><a href="/admin/units">Apartments</a><a href="/admin/gallery">Gallery</a><a href="/admin/reviews">Reviews</a><a href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">OPERATIONS</span><h1>Good to see you.</h1></div><a class="btn btn-outline" href="/" target="_blank">View website ↗</a></div><div class="metric-grid"><div><span>Total bookings</span><strong><%= totalBookings %></strong></div><div><span>Pending</span><strong><%= pending %></strong></div><div><span>Approved reviews</span><strong><%= approvedReviews %></strong></div><div><span>Confirmed revenue</span><strong><%= money(revenue) %> TZS</strong></div></div><section class="admin-card"><div class="admin-card-head"><h2>Recent bookings</h2><a href="/admin/bookings">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Ref</th><th>Guest</th><th>Apartment</th><th>Dates</th><th>Total</th><th>Status</th></tr></thead><tbody><% recentBookings.forEach(b=>{ %><tr><td><b><%= b.reference %></b></td><td><%= b.guestName %><br><small><%= b.guestPhone %></small></td><td><%= b.unitName %></td><td><%= b.checkIn.toLocaleDateString("en-GB") %> → <%= b.checkOut.toLocaleDateString("en-GB") %></td><td><%= money(b.total) %></td><td><span class="status <%= b.status %>"><%= b.status %></span></td></tr><% }) %></tbody></table></div></section></main></div>
