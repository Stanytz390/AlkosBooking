<%- include("partials/head", {title: "Bookings — Admin"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a href="/admin">Dashboard</a><a class="active" href="/admin/bookings">Bookings</a><a href="/admin/units">Apartments</a><a href="/admin/gallery">Gallery</a><a href="/admin/reviews">Reviews</a><a href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">RESERVATIONS</span><h1>Bookings</h1></div></div><section class="admin-card"><div class="table-wrap"><table><thead><tr><th>Guest</th><th>Apartment</th><th>Stay</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead><tbody><% bookings.forEach(b=>{ const msg = encodeURIComponent(`Hello ${b.guestName}, this is ALKOS Apartments regarding booking ${b.reference}. We received your request for ${b.unitName} from ${b.checkIn.toLocaleDateString("en-GB")} to ${b.checkOut.toLocaleDateString("en-GB")}.`); %><tr><td><b><%= b.guestName %></b><br><small><%= b.guestPhone %></small></td><td><%= b.unitName %><br><small><%= b.guests %> guests</small></td><td><%= b.checkIn.toLocaleDateString("en-GB") %><br>→ <%= b.checkOut.toLocaleDateString("en-GB") %></td><td><%= money(b.total) %> TZS</td><td><span class="status <%= b.status %>"><%= b.status %></span></td><td><div class="row-actions"><a class="mini" href="https://wa.me/<%= b.guestPhone.replace(/\D/g,'') %>?text=<%= msg %>" target="_blank">WhatsApp guest</a><form method="post" action="/admin/bookings/<%= b._id %>/status"><select name="status" onchange="this.form.submit()"><% ["pending","confirmed","cancelled","completed"].forEach(s=>{ %><option <%= b.status===s?"selected":"" %>><%= s %></option><% }) %></select></form><form method="post" action="/admin/bookings/<%= b._id %>/delete" onsubmit="return confirm('Delete this booking?')"><button class="danger">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section></main></div>
