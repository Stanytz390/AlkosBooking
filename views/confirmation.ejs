<%- include("partials/head", {title: "Booking Request " + booking.reference}) %>
<%- include("partials/nav") %>
<main class="center-page"><div class="success-card"><div class="success-icon">✓</div><span class="eyebrow">REQUEST CREATED</span><h1>Your booking request is ready.</h1><p>Reference <strong><%= booking.reference %></strong>. Send the prepared WhatsApp message to ALKOS Apartments to confirm your stay.</p><div class="summary-card"><div><span>Apartment</span><strong><%= booking.unitName %></strong></div><div><span>Dates</span><strong><%= booking.checkIn.toLocaleDateString("en-GB") %> — <%= booking.checkOut.toLocaleDateString("en-GB") %></strong></div><div><span>Guests</span><strong><%= booking.guests %></strong></div><div><span>Estimated total</span><strong><%= money(booking.total) %> TZS</strong></div></div><a class="btn btn-whatsapp wide" href="<%= waUrl %>" target="_blank">Open WhatsApp & send request</a><a class="text-link center-link" href="/">Return to website</a></div></main>
<%- include("partials/footer") %>
