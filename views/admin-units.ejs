<%- include("partials/head", {title: "Apartments — Admin"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a href="/admin">Dashboard</a><a href="/admin/bookings">Bookings</a><a class="active" href="/admin/units">Apartments</a><a href="/admin/gallery">Gallery</a><a href="/admin/reviews">Reviews</a><a href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">PROPERTY INVENTORY</span><h1>Apartments</h1></div></div><section class="admin-card"><h2>Add apartment</h2><form method="post" action="/admin/units" class="admin-form"><div class="form-row"><label>Name<input name="name" required></label><label>Floor<input name="floor"></label><label>Price / night<input name="price" type="number" required></label></div><div class="form-row"><label>Capacity<input name="capacity" type="number" value="6"></label><label>Bedrooms<input name="bedrooms" type="number" value="1"></label><label>Bathrooms<input name="bathrooms" type="number" value="1"></label></div><label>Description<textarea name="description"></textarea></label><label>Amenities <small>comma separated</small><input name="amenities" placeholder="Air conditioning, Hot water, Smart TV"></label><label>Image URLs <small>one per line</small><textarea name="images"></textarea></label><label class="check"><input type="checkbox" name="active" checked> Public</label><button class="btn btn-dark">Add apartment</button></form></section><% units.forEach(u=>{ %><section class="admin-card edit-card"><div class="admin-card-head"><h2><%= u.name %></h2><span class="status <%= u.status %>"><%= u.status %></span></div><form method="post" action="/admin/units/<%= u._id %>" class="admin-form"><div class="form-row"><label>Name<input name="name" value="<%= u.name %>"></label><label>Floor<input name="floor" value="<%= u.floor %>"></label><label>Price<input name="price" type="number" value="<%= u.price %>"></label></div><div class="form-row"><label>Capacity<input name="capacity" type="number" value="<%= u.capacity %>"></label><label>Bedrooms<input name="bedrooms" type="number" value="<%= u.bedrooms %>"></label><label>Bathrooms<input name="bathrooms" type="number" value="<%= u.bathrooms %>"></label></div><label>Description<textarea name="description"><%= u.description %></textarea></label><label>Amenities<input name="amenities" value="<%= u.amenities.join(', ') %>"></label><label>Image URLs<textarea name="images"><%= u.images.join('\n') %></textarea></label><div class="row-actions"><label>Status<select name="status"><option value="available" <%= u.status==="available"?"selected":"" %>>Available</option><option value="maintenance" <%= u.status==="maintenance"?"selected":"" %>>Maintenance</option><option value="hidden" <%= u.status==="hidden"?"selected":"" %>>Hidden</option></select></label><label class="check"><input type="checkbox" name="active" <%= u.active?"checked":"" %>> Public</label><button class="btn btn-dark">Save changes</button></form></section><% }) %></main></div>
