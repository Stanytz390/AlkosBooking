<%-include("partials/header",{title:"Book your stay | ALKOS"})%><section class="top"><div class="intro"><div class="kicker">RESERVATIONS</div><h1 class="title">Book your stay.</h1><p class="sub">Choose your apartment, dates and guest details.</p></div><form class="formbox" method="post" action="/booking"><div class="grid"><div class="field"><label>Apartment</label><select id="apartment" name="apartment" required><%apartments.forEach(a=>{%><option value="<%=a._id%>" data-price="<%=a.price%>" <%=selected==a._id.toString()?"selected":""%>><%=a.name%> — TZS <%=a.price.toLocaleString()%>/day</option><%})%></select></div><div class="field"><label>Guests</label><input type="number" name="guests" min="1" max="6" value="2" required></div><div class="field"><label>Check-in</label><input id="checkIn" type="date" name="checkIn" required></div><div class="field"><label>Check-out</label><input id="checkOut" type="date" name="checkOut" required></div><div class="field"><label>Full name</label><input name="guestName" required></div><div class="field"><label>Phone</label><input name="phone" required></div><div class="field"><label>WhatsApp</label><input name="whatsapp"></div><div class="field"><label>Email</label><input type="email" name="email"></div></div><div class="field"><label>Special request</label><textarea name="notes" rows="4"></textarea></div><div class="price">Estimated total: <span id="estimate">—</span></div><button class="btn gold">Confirm booking request</button></form></section><%-include("partials/footer")%>