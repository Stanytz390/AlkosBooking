<%-include("partials/header",{title:"Admin | ALKOS"})%><main class="admin-wrap"><div class="admin-head"><div><div class="kicker">CONTROL CENTER</div><h1 class="title">ALKOS Admin</h1></div><form method="post" action="/admin/logout"><button class="btn dark">Logout</button></form></div><div class="stats"><div class="stat">Apartments<b><%=stats.apartments%></b></div><div class="stat">Available<b><%=stats.available%></b></div><div class="stat">Pending<b><%=stats.pending%></b></div><div class="stat">Confirmed<b><%=stats.confirmed%></b></div></div><div class="admin-card" id="apartments"><h2>Manage apartments</h2><form method="post" action="/admin/apartments"><div class="grid"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Price / day</label><input name="price" type="number" required></div><div class="field"><label>Guests</label><input name="guests" type="number" value="6"></div><div class="field"><label>Bedrooms</label><input name="bedrooms" type="number" value="1"></div></div><div class="field"><label>Description</label><textarea name="description"></textarea></div><div class="field"><label>Image URLs, one per line</label><textarea name="images"></textarea></div><div class="field"><label>Amenities, comma separated</label><textarea name="amenities"></textarea></div><button class="btn gold">Add apartment</button></form><div class="table-wrap"><table class="table"><tr><th>Name</th><th>Price</th><th>Status</th><th>Action</th></tr><%apartments.forEach(a=>{%><tr><td><%=a.name%></td><td>TZS <%=a.price.toLocaleString()%></td><td><%=a.status%></td><td><form method="post" action="/admin/apartments/<%=a._id%>/delete"><button>Delete</button></form></td></tr><%})%></table></div></div><div class="admin-card" id="bookings"><h2>Bookings</h2><div class="table-wrap"><table class="table"><tr><th>Guest</th><th>Apartment</th><th>Dates</th><th>Total</th><th>Status</th></tr><%bookings.forEach(b=>{%><tr><td><%=b.guestName%><br><small><%=b.phone%></small></td><td><%=b.apartmentName%></td><td><%=new Date(b.checkIn).toLocaleDateString()%> → <%=new Date(b.checkOut).toLocaleDateString()%></td><td>TZS <%=b.total.toLocaleString()%></td><td><form method="post" action="/admin/bookings/<%=b._id%>/status"><select name="status" onchange="this.form.submit()"><%["pending","confirmed","cancelled","completed"].forEach(s=>{%><option <%=b.status===s?"selected":""%>><%=s%></option><%})%></select></form></td></tr><%})%></table></div></div><div class="admin-card" id="reviews"><h2>Reviews</h2><div class="table-wrap"><table class="table"><%reviews.forEach(r=>{%><tr><td><%=r.name%></td><td><%=r.rating%>/5</td><td><%=r.text%></td><td><form method="post" action="/admin/reviews/<%=r._id%>"><input type="hidden" name="approved" value="<%=r.approved?"false":"true"%>"><button><%=r.approved?"Hide":"Approve"%></button></form></td></tr><%})%></table></div></div></main><%-include("partials/footer")%>