<%-include("partials/header",{title:apartment.name+" | ALKOS"})%><section class="top"><div class="kicker">ALKOS APARTMENT</div><h1 class="title"><%=apartment.name%></h1><div class="gallery"><% (apartment.images?.length?apartment.images:["/images/room.jpg","/images/pool.jpg","/images/gym.jpg"]).forEach(i=>{%><img data-gallery src="<%=i%>" alt="ALKOS Apartment"> <%})%></div><div class="split"><div><h2 class="title small">Comfort, privacy and style.</h2><p class="sub left"><%=apartment.description%></p><div class="amenity-grid"><%apartment.amenities.forEach(x=>{%><div class="amenity"><strong><%=x%></strong></div><%})%></div></div><div class="formbox"><div class="kicker">FROM</div><div class="price">TZS <%=apartment.price.toLocaleString()%> / day</div><p>Up to <%=apartment.guests%> guests</p><a class="btn gold" href="/booking?apartment=<%=apartment._id%>">Book this apartment</a></div></div></section><div class="modal" id="imageViewer"><div class="modal-box darkbox"><button class="close" data-close="imageViewer">×</button><img alt="Gallery"></div></div><%-include("partials/footer")%>