<%- include("partials/head", {title: "Reviews — Admin"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a href="/admin">Dashboard</a><a href="/admin/bookings">Bookings</a><a href="/admin/units">Apartments</a><a href="/admin/gallery">Gallery</a><a class="active" href="/admin/reviews">Reviews</a><a href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">SOCIAL PROOF</span><h1>Reviews</h1></div></div><div class="review-admin-grid"><% reviews.forEach(r=>{ %><article class="review admin-review"><div class="stars"><%= "★".repeat(r.rating) %></div><p>“<%= r.text %>”</p><strong><%= r.name %></strong><small><%= r.approved?"Published":"Waiting approval" %></small><div class="row-actions"><form method="post" action="/admin/reviews/<%= r._id %>/toggle"><button class="mini"><%= r.approved?"Hide":"Approve" %></button></form><form method="post" action="/admin/reviews/<%= r._id %>/delete"><button class="danger">Delete</button></form></div></article><% }) %></div></main></div>
