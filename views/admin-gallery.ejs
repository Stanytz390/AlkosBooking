<%- include("partials/head", {title: "Gallery — Admin"}) %>
<div class="admin-shell"><aside class="admin-side"><div class="admin-brand"><img src="/images/logo.jpg"><b>ALKOS <small>ADMIN</small></b></div><a href="/admin">Dashboard</a><a href="/admin/bookings">Bookings</a><a href="/admin/units">Apartments</a><a class="active" href="/admin/gallery">Gallery</a><a href="/admin/reviews">Reviews</a><a href="/admin/settings">Settings</a><form method="post" action="/admin/logout"><button>Logout</button></form></aside><main class="admin-main"><div class="admin-top"><div><span class="eyebrow">VISUAL CONTENT</span><h1>Gallery</h1></div></div><section class="admin-card"><h2>Add image</h2><form method="post" action="/admin/gallery" class="admin-form"><div class="form-row"><label>Title<input name="title"></label><label>Category<input name="category" value="Property"></label></div><label>Image URL<input name="imageUrl" required placeholder="https://..."></label><label class="check"><input type="checkbox" name="active" checked> Public</label><button class="btn btn-dark">Add image</button></form></section><div class="admin-gallery"><% gallery.forEach(g=>{ %><div class="admin-gallery-card"><img src="<%= g.imageUrl %>" alt=""><div><b><%= g.title %></b><small><%= g.category %></small><form method="post" action="/admin/gallery/<%= g._id %>/delete"><button class="danger">Delete</button></form></div></div><% }) %></div></main></div>
