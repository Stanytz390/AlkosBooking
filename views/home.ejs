<%- include("partials/head", {title: settings.propertyName + " — Geita"}) %>
<%- include("partials/nav") %>

<main>
<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <div class="eyebrow">MSETO · GEITA · TANZANIA</div>
    <h1>Stay private.<br><em>Stay beautifully.</em></h1>
    <p><%= settings.tagline %> Modern one-bedroom apartments with the comfort of home and the feel of a premium retreat.</p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="#book">Check availability <span>→</span></a>
      <a class="btn btn-ghost" href="#gallery">Explore property</a>
    </div>
    <div class="hero-proof"><span>●</span> Available for short & extended stays <span class="dot">·</span> Up to 6 guests</div>
  </div>
  <div class="hero-scroll">SCROLL <span>↓</span></div>
</section>

<section class="booking-strip" id="book">
  <div class="container booking-box">
    <div class="booking-intro"><span class="eyebrow">DIRECT BOOKING</span><strong>Find your stay</strong></div>
    <div class="booking-fields">
      <label>Check-in<input type="date" id="checkIn"></label>
      <label>Check-out<input type="date" id="checkOut"></label>
      <label>Guests<select id="guests"><% for(let i=1;i<=6;i++){ %><option><%= i %></option><% } %></select></label>
      <button class="btn btn-dark" id="searchAvailability">Search availability</button>
    </div>
  </div>
</section>

<section class="section" id="stay">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow">THE APARTMENTS</span><h2>Choose your space.</h2></div><p>Every unit is self-contained, private and ready for independent living.</p></div>
    <div class="unit-grid">
      <% units.forEach((u, idx) => { %>
      <article class="unit-card" data-unit="<%= u._id %>">
        <div class="unit-image">
          <img src="<%= u.images[0] || '/images/living-1.jpg' %>" alt="<%= u.name %>">
          <span class="status-pill available"><i></i> Available</span>
          <button class="icon-btn gallery-open" data-images='<%- JSON.stringify(u.images) %>' aria-label="View photos">↗</button>
        </div>
        <div class="unit-body">
          <div class="unit-top"><span><%= u.floor %></span><span>Up to <%= u.capacity %> guests</span></div>
          <h3><%= u.name %></h3>
          <p><%= u.description %></p>
          <div class="chips"><% u.amenities.slice(0,5).forEach(a=>{ %><span><%= a %></span><% }) %></div>
          <div class="unit-bottom">
            <div><small>From</small><strong><%= money(u.price) %> <em>TZS</em></strong><small>/ night</small></div>
            <a class="btn btn-dark btn-sm" href="/book/<%= u._id %>">Book apartment</a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <div id="availabilityResults" class="availability-results hidden"></div>
  </div>
</section>

<section class="split-section dark" id="amenities">
  <div class="container split-grid">
    <div class="split-copy">
      <span class="eyebrow gold">EVERYTHING YOU NEED</span>
      <h2>Comfort without compromise.</h2>
      <p>Come for the location. Stay for the feeling. ALKOS Apartments combines privacy, modern interiors and practical amenities for a genuinely easy stay.</p>
      <a class="text-link" href="#book">Plan your stay <span>→</span></a>
    </div>
    <div class="amenity-grid">
      <div><b>01</b><strong>Free high-speed Wi-Fi</strong><span>Stay connected from every room.</span></div>
      <div><b>02</b><strong>Swimming pool</strong><span>Relax and reset on-site.</span></div>
      <div><b>03</b><strong>Modern gym</strong><span>Keep your routine while travelling.</span></div>
      <div><b>04</b><strong>Smart sauna</strong><span>Unwind after a long day.</span></div>
      <div><b>05</b><strong>Self-contained kitchen</strong><span>Cook your own meals privately.</span></div>
      <div><b>06</b><strong>24/7 security</strong><span>CCTV, secure parking and reliable power.</span></div>
      <div><b>07</b><strong>Food & drinks</strong><span>Order meals and refreshments through reception.</span></div>
      <div><b>08</b><strong>Smart entertainment</strong><span>Large TV with DStv / Azam options.</span></div>
    </div>
  </div>
</section>

<section class="image-feature">
  <div class="feature-image"><img src="/images/pool.jpg" alt="ALKOS Apartments swimming pool"></div>
  <div class="feature-copy">
    <span class="eyebrow">YOUR PRIVATE RETREAT</span>
    <h2>More than a room.</h2>
    <p>Each apartment gives you a bedroom, living space, kitchen and the freedom to make your own routine. Ideal for couples, professionals, families and longer stays.</p>
    <div class="feature-stats"><div><strong>6</strong><span>Max guests</span></div><div><strong>24/7</strong><span>Electricity & security</span></div><div><strong>1</strong><span>Private apartment</span></div></div>
  </div>
</section>

<section class="section gallery-section" id="gallery">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow">THE GALLERY</span><h2>See the experience.</h2></div><button class="btn btn-outline gallery-all">View all photos</button></div>
    <div class="masonry">
      <% gallery.slice(0,5).forEach((g,i)=>{ %><button class="gallery-tile tile-<%= i %>" data-src="<%= g.imageUrl %>" data-title="<%= g.title %>"><img src="<%= g.imageUrl %>" alt="<%= g.title %>"><span><%= g.title %> ↗</span></button><% }) %>
    </div>
  </div>
</section>

<section class="section review-section" id="reviews">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow">GUEST NOTES</span><h2>Feel at home, away from home.</h2></div><button class="btn btn-dark" data-modal-open="reviewModal">Leave a review</button></div>
    <div class="reviews">
      <% if (!reviews.length) { %><div class="empty-review">Be our first guest to leave a review.</div><% } %>
      <% reviews.forEach(r=>{ %><article class="review"><div class="stars"><%= "★".repeat(r.rating) %></div><p>“<%= r.text %>”</p><strong><%= r.name %></strong><small>Verified guest review</small></article><% }) %>
    </div>
  </div>
</section>

<section class="location-band">
  <div class="container location-inner">
    <div><span class="eyebrow">FIND US</span><h2>Central Geita. Quiet Mseto.</h2><p><%= settings.location %> · Easy access to the town centre.</p></div>
    <a class="btn btn-gold" href="<%= settings.mapUrl %>" target="_blank">Open Google Maps ↗</a>
  </div>
</section>
</main>

<div class="modal" id="reviewModal"><div class="modal-card"><button class="modal-close" data-modal-close>×</button><span class="eyebrow">YOUR EXPERIENCE</span><h3>Tell future guests.</h3><form method="post" action="/reviews"><label>Name<input name="name" required></label><label>Rating<select name="rating"><option value="5">★★★★★ — Excellent</option><option value="4">★★★★☆ — Great</option><option value="3">★★★☆☆ — Good</option><option value="2">★★☆☆☆ — Fair</option><option value="1">★☆☆☆☆ — Poor</option></select></label><label>Your review<textarea name="text" rows="5" required></textarea></label><button class="btn btn-dark wide">Submit review</button></form></div></div>
<div class="modal" id="galleryModal"><div class="modal-card modal-gallery"><button class="modal-close" data-modal-close>×</button><img id="modalGalleryImage" src="" alt=""><div id="modalGalleryTitle"></div></div></div>
<div class="toast" id="toast">Review submitted for approval.</div>

<%- include("partials/footer") %>
