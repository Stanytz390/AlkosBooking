<%-include("partials/header",{title:"ALKOS Apartment | Geita"})%><header class="hero"><div class="hero-content"><div class="eyebrow">MSETO · GEITA · TANZANIA</div><h1>Exceptional stays.<br>Unforgettable experience.</h1><p>Hosting you with comfort, style, and care. Relax and feel at home with us.</p><div class="actions"><a class="btn gold" href="/booking">Book your stay</a><a class="btn light" href="/apartments">Explore apartments</a></div></div></header><section class="intro"><div class="kicker">ALKOS APARTMENT</div><h2 class="title">A better way to stay in Geita.</h2><p class="sub">Self-contained one-bedroom apartments with smart kitchens, air conditioning, hot water, entertainment, reliable electricity, secure parking, CCTV and high-speed Wi-Fi.</p></section><section><div class="kicker">STAYS</div><h2 class="title">Choose your space.</h2><div class="horizontal"><%apartments.forEach(a=>{%><article class="card"><div class="card-img" style="background-image:url('<%=a.images?.[0]||"/images/room.jpg"%>')"></div><div class="card-body"><h3><%=a.name%></h3><div class="meta"><%=a.bedrooms%> bedroom · Up to <%=a.guests%> guests</div><div class="price">TZS <%=a.price.toLocaleString()%> / day</div><a class="btn dark" href="/apartments/<%=a._id%>">View details</a></div></article><%})%></div></section><section><div class="kicker">AMENITIES</div><h2 class="title">Everything you need.</h2><div class="amenity-grid"><%[["Swimming Pool","Relax and refresh."],["Modern Gym","Keep your routine going."],["Smart Sauna","Relax and recharge."],["Free Wi-Fi","Stay connected."],["Air Conditioning","Quiet comfort."],["Smart Kitchen","Cook your meals."],["DStv / Azam","Entertainment at home."],["Security","CCTV and secure parking."]].forEach(x=>{%><div class="amenity"><strong><%=x[0]%></strong><span><%=x[1]%></span></div><%})%></div></section><section id="reviews" class="intro"><div class="kicker">GUEST VOICES</div><h2 class="title">Stay. Feel. Remember.</h2><div class="horizontal"><%reviews.forEach(r=>{%><article class="card"><div class="card-body"><b>★★★★★</b><h3><%=r.name%></h3><p><%=r.text%></p></div></article><%})%></div><button class="btn dark" data-modal="reviewModal">Leave a review</button></section><div class="modal" id="reviewModal"><div class="modal-box"><button class="close" data-close="reviewModal">×</button><h2 class="title">Your experience</h2><form method="post" action="/reviews"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Rating</label><select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></div><div class="field"><label>Review</label><textarea name="text" rows="5" required></textarea></div><button class="btn gold">Submit review</button></form></div></div><%-include("partials/footer")%>